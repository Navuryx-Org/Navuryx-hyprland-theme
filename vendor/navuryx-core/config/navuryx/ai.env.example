# Copy to ai.env and chmod 600.
NAVURYX_AI_PROVIDER=ollama
NAVURYX_AI_MODEL=gemma3:4b
NAVURYX_VISION_MODEL=gemma3:4b
NAVURYX_OLLAMA_URL=http://127.0.0.1:11434
NAVURYX_AI_SYSTEM='You are Navuryx, a concise Linux desktop assistant. Prefer safe commands and explain destructive actions before suggesting them.'

# Optional OpenAI-compatible provider:
# NAVURYX_AI_PROVIDER=openai
# NAVURYX_AI_ENDPOINT=https://api.openai.com/v1/chat/completions
# NAVURYX_AI_API_KEY=
# NAVURYX_AI_MODEL=
