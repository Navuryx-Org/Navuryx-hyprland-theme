#!/usr/bin/env bash
set -euo pipefail
source "${XDG_CONFIG_HOME:-$HOME/.config}/navuryx/bin/navuryx-common"

PROFILE_DIR="$NAV_DATA/profiles"
ACTIVE_FILE="$PROFILE_DIR/active"
mkdir -p "$PROFILE_DIR"

active_profile() {
  [[ -f "$ACTIVE_FILE" ]] && cat "$ACTIVE_FILE" || printf 'default'
}

set_power_profile() {
  local target="$1"
  command -v powerprofilesctl >/dev/null 2>&1 || return 0
  powerprofilesctl set "$target" >/dev/null 2>&1 || true
}

pause_effects() {
  pkill -x hypridle >/dev/null 2>&1 || true
  pkill -x hyprsunset >/dev/null 2>&1 || true
}

resume_effects() {
  if command -v hypridle >/dev/null 2>&1 && ! pgrep -x hypridle >/dev/null 2>&1; then
    nohup hypridle >/dev/null 2>&1 &
  fi
}

enable_gaming() {
  "$NAV_CONFIG/bin/navuryx-settings" --profile gaming
  set_power_profile performance
  pause_effects
  notify 'Gaming mode' 'Effects reduced, idle paused, performance profile requested'
}

disable_gaming() {
  "$NAV_CONFIG/bin/navuryx-settings" --profile default
  set_power_profile balanced
  resume_effects
  notify 'Gaming mode' 'Default Navuryx desktop restored'
}

case "${1:-}" in
  --on) enable_gaming ;;
  --off) disable_gaming ;;
  --status) active_profile; printf '\n' ;;
  --waybar)
    if [[ "$(active_profile)" == gaming ]]; then
      printf '{"text":"󰊗","tooltip":"Gaming mode on","class":"active"}\n'
    else
      printf '{"text":"","tooltip":"Gaming mode off","class":"inactive"}\n'
    fi
    ;;
  *)
    if [[ "$(active_profile)" == gaming ]]; then
      disable_gaming
    else
      enable_gaming
    fi
    ;;
esac
