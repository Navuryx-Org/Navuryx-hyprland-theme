#!/usr/bin/env bash
set -euo pipefail
source "${XDG_CONFIG_HOME:-$HOME/.config}/navuryx/bin/navuryx-common"

HYPR_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/hypr"
WALL_DIR="$NAV_CONFIG/wallpapers"
WALL_CONF="$NAV_CONFIG/wallpaper.conf"
CURRENT_LINK="$NAV_CONFIG/current-wallpaper"
COLORS_DIR="$NAV_DATA/colors"
PER_MONITOR="$NAV_DATA/wallpapers-per-monitor"
FIT_MODE="${NAVURYX_WALLPAPER_FIT:-cover}"
TRANSITION="${NAVURYX_WALLPAPER_TRANSITION:-grow}"
MONITOR=""
QUIET=0

mkdir -p "$WALL_DIR" "$COLORS_DIR" "$NAV_DATA"

list_monitors() {
  command -v hyprctl >/dev/null 2>&1 || return 1
  if command -v jq >/dev/null 2>&1; then
    hyprctl -j monitors 2>/dev/null | jq -r '.[].name' 2>/dev/null
  else
    hyprctl monitors 2>/dev/null | awk '/^Monitor /{print $2}'
  fi
}

remember_monitor_wallpaper() {
  local monitor="$1" path="$2" tmp
  [[ -n "$monitor" ]] || return 0
  tmp="$(mktemp)"
  if [[ -f "$PER_MONITOR" ]]; then
    grep -v "^${monitor}|" "$PER_MONITOR" > "$tmp" 2>/dev/null || true
  fi
  printf '%s|%s\n' "$monitor" "$path" >> "$tmp"
  mv "$tmp" "$PER_MONITOR"
}

wallpaper_blocks() {
  local path="$1" monitor entry
  if [[ -f "$PER_MONITOR" ]]; then
    while IFS='|' read -r monitor entry; do
      [[ -z "$monitor" || -z "$entry" ]] && continue
      [[ -f "$entry" ]] || continue
      printf 'wallpaper {\n    monitor = %s\n    path = %s\n    fit_mode = %s\n}\n\n' "$monitor" "$entry" "$FIT_MODE"
    done < "$PER_MONITOR"
  fi
  printf 'wallpaper {\n    monitor =\n    path = %s\n    fit_mode = %s\n}\n' "$path" "$FIT_MODE"
}

write_wall_conf() {
  local path="$1"
  wallpaper_blocks "$path" > "$WALL_CONF"
  {
    printf 'splash = false\nipc = true\n\n'
    wallpaper_blocks "$path"
  } > "$HYPR_DIR/hyprpaper.conf"
  ln -sfn "$path" "$CURRENT_LINK"
}

ensure_hyprpaper() {
  command -v hyprpaper >/dev/null 2>&1 || return 1
  if ! pgrep -x hyprpaper >/dev/null 2>&1; then
    mkdir -p "${XDG_STATE_HOME:-$HOME/.local/state}/navuryx"
    nohup hyprpaper >"${XDG_STATE_HOME:-$HOME/.local/state}/navuryx/hyprpaper.log" 2>&1 &
    disown || true
    sleep 0.45
  fi
  return 0
}

apply_hyprpaper() {
  local path="$1"
  ensure_hyprpaper || return 1
  hyprctl hyprpaper preload "$path" >/dev/null 2>&1 || true
  hyprctl hyprpaper wallpaper "$MONITOR,$path,$FIT_MODE" >/dev/null 2>&1 \
    || hyprctl hyprpaper wallpaper "$MONITOR, $path, $FIT_MODE" >/dev/null 2>&1 \
    || hyprctl hyprpaper wallpaper "$MONITOR,$path" >/dev/null 2>&1 \
    || {
      pkill -x hyprpaper >/dev/null 2>&1 || true
      sleep 0.2
      nohup hyprpaper >"${XDG_STATE_HOME:-$HOME/.local/state}/navuryx/hyprpaper.log" 2>&1 &
      disown || true
      sleep 0.55
      hyprctl hyprpaper wallpaper "$MONITOR,$path,$FIT_MODE" >/dev/null 2>&1 || hyprctl hyprpaper wallpaper "$MONITOR,$path" >/dev/null 2>&1
    }
}

apply_swww() {
  local path="$1"
  command -v swww >/dev/null 2>&1 || return 1
  if ! swww query >/dev/null 2>&1; then
    swww-daemon --format xrgb >/dev/null 2>&1 &
    disown || true
    local i=0
    while ! swww query >/dev/null 2>&1 && ((i < 40)); do
      sleep 0.1
      i=$((i + 1))
    done
  fi
  local -a outputs=()
  [[ -n "$MONITOR" ]] && outputs=(--outputs "$MONITOR")
  swww img "$path" \
    "${outputs[@]}" \
    --transition-type "$TRANSITION" \
    --transition-duration 0.45 \
    --transition-fps 60 \
    --invert-y \
    --transition-pos "$(hyprctl cursorpos 2>/dev/null | grep -E '^[0-9]' || echo '0,0')" >/dev/null 2>&1
}

colors_are_cached() {
  local path="$1" stamp cached
  stamp="$(stat -c '%n:%Y' "$path" 2>/dev/null || printf '%s' "$path")"
  cached="$(cat "$COLORS_DIR/source" 2>/dev/null || true)"
  [[ -n "$cached" && "$cached" == "$stamp" ]]
}

remember_color_source() {
  local path="$1"
  stat -c '%n:%Y' "$path" > "$COLORS_DIR/source" 2>/dev/null || printf '%s' "$path" > "$COLORS_DIR/source"
}

run_matugen() {
  local path="$1"
  command -v matugen >/dev/null 2>&1 || return 0
  matugen image "$path" --mode dark --json hex > "$COLORS_DIR/matugen.json" 2>/dev/null \
    || matugen image "$path" --json hex > "$COLORS_DIR/matugen.json" 2>/dev/null \
    || true
  if [[ -f "$COLORS_DIR/matugen.json" ]]; then
    local primary secondary
    primary="$(jq -r '.colors.dark.primary // .colors.primary // empty' "$COLORS_DIR/matugen.json" 2>/dev/null || true)"
    secondary="$(jq -r '.colors.dark.secondary // .colors.secondary // empty' "$COLORS_DIR/matugen.json" 2>/dev/null || true)"
    if [[ -n "$primary" ]]; then
      printf 'primary=%s\nsecondary=%s\nscheme=dark\n' "$primary" "$secondary" > "$COLORS_DIR/navuryx.env"
    fi
  fi
}

run_wallbash() {
  local path="$1"
  local out="$COLORS_DIR/wallbash.css"
  if command -v magick >/dev/null 2>&1; then
    local hex
    hex="$(magick "$path" -resize 1x1! -format '%[hex:u]' info: 2>/dev/null || true)"
    if [[ -n "$hex" ]]; then
      cat > "$out" <<EOF
@define-color wallbash_bg #${hex:0:6};
@define-color wallbash_fg #d9e0ff;
EOF
      printf 'wallbash=#%s\n' "${hex:0:6}" >> "$COLORS_DIR/navuryx.env"
    fi
  elif command -v convert >/dev/null 2>&1; then
    local hex
    hex="$(convert "$path" -resize 1x1! -format '%[hex:u]' info: 2>/dev/null || true)"
    if [[ -n "$hex" ]]; then
      cat > "$out" <<EOF
@define-color wallbash_bg #${hex:0:6};
@define-color wallbash_fg #d9e0ff;
EOF
    fi
  fi
}

apply_wallpaper() {
  local path="$1"
  [[ -f "$path" ]] || { [[ "$QUIET" == 1 ]] || notify 'Wallpaper' "Missing file: $path"; return 1; }
  path="$(readlink -f "$path")"

  if [[ -n "$MONITOR" ]]; then
    remember_monitor_wallpaper "$MONITOR" "$path"
    local global
    global="$(default_wallpaper || true)"
    [[ -n "${global:-}" && -f "${global:-}" ]] || global="$path"
    write_wall_conf "$global"
  else
    write_wall_conf "$path"
  fi

  local ok=0
  apply_hyprpaper "$path" && ok=1
  apply_swww "$path" && ok=1
  if ! colors_are_cached "$path"; then
    run_matugen "$path" || true
    run_wallbash "$path" || true
    remember_color_source "$path"
  fi
  if [[ "$ok" -eq 1 ]]; then
    [[ "$QUIET" == 1 ]] || notify 'Wallpaper' "$(basename "$path")"
    return 0
  fi
  [[ "$QUIET" == 1 ]] || notify 'Wallpaper' 'hyprpaper/swww failed to apply wallpaper'
  return 1
}

default_wallpaper() {
  if [[ -L "$CURRENT_LINK" || -f "$CURRENT_LINK" ]]; then
    readlink -f "$CURRENT_LINK"
    return 0
  fi
  if [[ -f "$WALL_CONF" ]]; then
    local conf_path
    conf_path="$(awk -F'= *' '/^[[:space:]]*path[[:space:]]*=/{print $2; exit}' "$WALL_CONF" | tr -d '[:space:]')"
    conf_path="${conf_path/#\~/$HOME}"
    conf_path="${conf_path/\$HOME/$HOME}"
    if [[ -n "$conf_path" && -f "$conf_path" ]]; then
      printf '%s\n' "$conf_path"
      return 0
    fi
  fi
  local candidate
  for candidate in \
    "$WALL_DIR/wallpaper.png" \
    "$WALL_DIR/wallpaper1.png" \
    "$WALL_DIR/navuryx-default.png" \
    "$WALL_DIR/navuryx-nocturne.jpg" \
    "$WALL_DIR/wallpaper2.png" \
    "$WALL_DIR/wallpaper3.png" \
    "$WALL_DIR/wallpaper4.png"
  do
    if [[ -f "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  find "$WALL_DIR" -maxdepth 1 -type f \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \) 2>/dev/null | sort | head -1
}

restore_wallpaper() {
  mkdir -p "$WALL_DIR"
  local path
  path="$(default_wallpaper || true)"
  if [[ -z "${path:-}" || ! -f "$path" ]]; then
    [[ "$QUIET" == 1 ]] || notify 'Wallpaper' 'No wallpapers installed under ~/.config/navuryx/wallpapers'
    return 1
  fi
  apply_wallpaper "$path"
}

pick_wallpaper() {
  mkdir -p "$WALL_DIR" "$HOME/Pictures/Wallpapers"
  mapfile -t files < <(find "$WALL_DIR" "$HOME/Pictures/Wallpapers" -type f \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' -o -iname '*.jxl' \) 2>/dev/null | sort -u)
  ((${#files[@]})) || { notify 'Wallpaper' 'No wallpapers found.'; exit 1; }
  local selected
  selected="$(printf '%s\n' "${files[@]}" | menu -p 'Wallpaper')" || exit 0
  [[ -f "$selected" ]] || exit 0
  apply_wallpaper "$selected"
}

pick_monitor_wallpaper() {
  mapfile -t monitors < <(list_monitors || true)
  if ((${#monitors[@]} == 0)); then
    notify 'Wallpaper' 'No monitors reported by Hyprland'
    return 1
  fi
  local chosen
  chosen="$(printf '%s\n' "${monitors[@]}" | menu -p 'Monitor')" || return 0
  [[ -n "$chosen" ]] || return 0
  MONITOR="$chosen"
  pick_wallpaper
}

clear_monitor_wallpapers() {
  rm -f "$PER_MONITOR"
  MONITOR=""
  local path
  path="$(default_wallpaper || true)"
  if [[ -n "${path:-}" && -f "$path" ]]; then
    apply_wallpaper "$path"
  fi
  notify 'Wallpaper' 'Per-monitor wallpapers cleared'
}

automation_toggle() {
  local flag="$NAV_DATA/wallpaper-auto"
  if [[ -f "$flag" ]]; then
    rm -f "$flag"
    notify 'Wallpaper' 'Automation off'
  else
    printf '300\n' > "$flag"
    notify 'Wallpaper' 'Automation on (5 min). Run navuryx-wallpaper --daemon'
  fi
}

run_daemon() {
  local flag="$NAV_DATA/wallpaper-auto"
  local interval=300
  while true; do
    [[ -f "$flag" ]] || exit 0
    interval="$(tr -d '[:space:]' < "$flag" || true)"
    [[ "$interval" =~ ^[0-9]+$ ]] || interval=300
    mapfile -t files < <(find "$WALL_DIR" -maxdepth 1 -type f \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \) 2>/dev/null | sort -u)
    if ((${#files[@]})); then
      QUIET=1
      apply_wallpaper "${files[RANDOM % ${#files[@]}]}" || true
    fi
    sleep "$interval"
  done
}

if [[ "${1:-}" == --monitor ]]; then
  MONITOR="${2:-}"
  shift 2 || true
fi

case "${1:-}" in
  --monitors)
    list_monitors || printf 'No monitors reported\n'
    ;;
  --per-monitor)
    pick_monitor_wallpaper || true
    ;;
  --clear-monitors)
    clear_monitor_wallpapers
    ;;
  --restore|restore)
    QUIET=1
    restore_wallpaper
    ;;
  --set)
    [[ -n "${2:-}" ]] || { printf 'Usage: navuryx-wallpaper --set /path/to/image\n' >&2; exit 2; }
    apply_wallpaper "$2"
    ;;
  --random|random)
    mapfile -t files < <(find "$WALL_DIR" -maxdepth 1 -type f \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \) 2>/dev/null | sort -u)
    ((${#files[@]})) || { notify 'Wallpaper' 'No wallpapers found.'; exit 1; }
    apply_wallpaper "${files[RANDOM % ${#files[@]}]}"
    ;;
  --next|next)
    mapfile -t files < <(find "$WALL_DIR" -maxdepth 1 -type f \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \) 2>/dev/null | sort -u)
    ((${#files[@]})) || exit 1
    cur="$(readlink -f "$CURRENT_LINK" 2>/dev/null || true)"
    next="${files[0]}"
    for i in "${!files[@]}"; do
      if [[ "$(readlink -f "${files[$i]}")" == "$cur" ]]; then
        next="${files[$(( (i + 1) % ${#files[@]} ))]}"
        break
      fi
    done
    apply_wallpaper "$next"
    ;;
  --auto|auto)
    automation_toggle
    ;;
  --daemon|daemon)
    run_daemon
    ;;
  --transition)
    TRANSITION="${2:-grow}"
    pick_wallpaper
    ;;
  *)
    pick_wallpaper
    ;;
esac
